# ==============================================================
#  Mape API — variables de entorno (plantilla)
#  Copia este archivo como .env y rellena los valores reales.
#  NO subas tu .env al repositorio (ya está en .gitignore).
# ==============================================================

# ── Base de datos (PostgreSQL) ────────────────────────────────
# Formato: postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE?schema=public
DATABASE_URL="postgresql://usuario:clave@localhost:5432/mape-radio?schema=public"

# ── Servidor ──────────────────────────────────────────────────
PORT=3040
# Orígenes permitidos por CORS. "*" para desarrollo; en producción
# usa el/los dominios reales, ej. "https://api.tudominio.com"
CORS_ORIGIN="*"

# ── JWT (autenticación) ───────────────────────────────────────
# Genera secretos largos y aleatorios: openssl rand -hex 32
JWT_ACCESS_SECRET="cambia-esto-por-un-secreto-largo"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="cambia-esto-por-otro-secreto-distinto"
JWT_REFRESH_TTL="30d"

# ── OTP (recuperación de acceso) ──────────────────────────────
# Minutos de validez del código. El envío real (email/SMS) no está
# activo: el código se registra en el log del servidor.
OTP_TTL_MINUTES=10

# ── Reglas de alertas — exceso de velocidad ───────────────────
# Límite de velocidad en km/h que dispara la alerta.
SPEED_LIMIT_KMH=90
# Km/h por encima del límite para escalar la alerta a CRÍTICA.
SPEED_CRITICAL_MARGIN_KMH=20

# ── Notificaciones push (Expo) ────────────────────────────────
# Opcional. Sin token funciona igual; para producción/volumen genera
# un Access Token en https://expo.dev (Account settings → Access tokens).
EXPO_ACCESS_TOKEN=

# ── Sistema de personal (RRHH) ────────────────────────────────
# Endpoint público que devuelve el personal ACTIVO para crear los usuarios
# que acceden a la app (POST /api/users/sync-personal lo consume).
PERSONAL_API_URL=http://api.syemape.com/api/publico/personal

# ── LiveKit (opcional) ────────────────────────────────────────
# NO es necesario: el audio PTT del radio funciona por el WebSocket
# de este mismo servidor. Deja vacío salvo que uses LiveKit.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
